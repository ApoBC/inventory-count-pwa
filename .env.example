# Base de datos
DB_USER=counting
DB_PASSWORD=secret
DB_NAME=counting_dev
DB_PORT=5432
DATABASE_URL=postgresql://counting:secret@localhost:5432/counting_dev

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT
JWT_SECRET=dev-secret-key-change-in-prod
JWT_EXPIRES_IN=24h

# ERP Provider (mock | erpnext | d365)
ERP_PROVIDER=mock

# URLs Internas (para orquestación entre servicios)
API_GATEWAY_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
COUNTING_SERVICE_URL=http://localhost:3003
ERP_GATEWAY_URL=http://localhost:3004
ERP_MOCK_URL=http://localhost:3005

# Configuración general
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:5173

# Índice de operarios de prueba (separados por coma)
TEST_OPERATOR_IDS=OP001,OP002,OP003
TEST_SUPERVISOR_IDS=SV001,SV002
